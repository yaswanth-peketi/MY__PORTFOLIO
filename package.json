{
  "name": "my-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Personal Portfolio of Peketi Yaswanth with Node.js authentication, email verification, Razorpay payments, and ELK logging",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "test:elk": "npm --prefix backend run test:elk"
  },
  "engines": {
    "node": ">=20"
  }
}
