# Render provides PORT automatically.
NODE_ENV=development
PORT=3000

# Paste the Render PostgreSQL Internal Database URL when backend and DB are in Render.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# For Render PostgreSQL, keep true. Local PostgreSQL can use false.
DATABASE_SSL=true

# Generate a long random secret, e.g. openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=1h

# Resend API key. Never put this in frontend JavaScript or GitHub.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# Must be a verified sender/domain in Resend. Example: Portfolio Security <security@yourdomain.com>
RESEND_FROM=Portfolio Security <security@your-verified-domain.com>

# Exact GitHub Pages origin, no trailing slash. Add your custom domain if you use one.
FRONTEND_URL=https://YOUR_GITHUB_USERNAME.github.io
# Optional comma-separated extra allowed origins
EXTRA_ALLOWED_ORIGINS=
OTP_TTL_MINUTES=10

# Razorpay Payment Credentials
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# ==============================================================================
# ELK (Elasticsearch, Logstash, Kibana) Configuration
# ==============================================================================
# Option 1: Local Docker ELK Stack
# ELASTICSEARCH_NODE=http://localhost:9200
#
# Option 2: Render Backend to Local ELK via 100% Free Cloudflare Tunnel
# ELASTICSEARCH_NODE=https://your-tunnel-id.trycloudflare.com
#
# Option 3: Elastic Cloud / Bonsai / Managed Elasticsearch
# ELASTICSEARCH_NODE=https://your-elastic-deployment.es.us-east-1.aws.elastic.cloud:9243
# ELASTICSEARCH_API_KEY=your_base64_encoded_api_key
# ELASTIC_CLOUD_ID=your_deployment_cloud_id
#
# Optional Basic Auth (if username/password used instead of API key):
# ELASTICSEARCH_USERNAME=elastic
# ELASTICSEARCH_PASSWORD=changeme
#
# Index Name where login and audit logs are shipped (Default: portfolio-logs)
ELASTICSEARCH_INDEX=portfolio-logs
# Set to false if connecting to a local Docker container with self-signed TLS certificates
ELASTICSEARCH_TLS_REJECT_UNAUTHORIZED=true
